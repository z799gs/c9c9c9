</div>

<div class="cooldown-section">
<div class="cooldown-bar"><div class="cooldown-fill" id="cooldown-fill"></div></div>
<span class="cooldown-time" id="cooldown-time"></span>
</div>

<div class="canvas-stats">
<span>🖼️ <span id="pixel-count">0</span> pixels</span>
<span>⏰ Reset: <span id="reset-time">12h</span></span>
</div>

<div class="leaderboard">
<div class="lb-header" id="lb-header">🏆 Top Artists <span>▼</span></div>
<div class="lb-content" id="lb-content"></div>
</div>
</div>

<div class="chat-section">
<div class="chat-header">
<span class="room-name">#<span id="room-name">general</span></span>
<select id="room-select" class="room-select">
<option value="general">General</option>
<option value="art">Art Talk</option>
<option value="random">Random</option>
</select>
</div>

<div class="chat-messages" id="chat-messages">
<div class="chat-welcome">
<span class="welcome-icon">👋</span>
<span>Welcome! Be nice & have fun!</span>
</div>
</div>

<div class="chat-status" id="chat-status">
<span class="status-dot"></span>
<span class="status-text">Connecting...</span>
</div>

<div class="chat-input">
<input type="text" id="msg-input" placeholder="Type message..." maxlength="150">
<button id="send-btn">Send</button>
</div>

<div class="rules-panel">
<div class="rules-title">📋 Rules</div>
<ul>
<li>Letters only</li>
<li>Be respectful</li>
<li>No personal info</li>
<li>No links</li>
</ul>
</div>
</div>
</div>
</div>
<div class="toast-container" id="toast-container"></div>
</div>`;
cacheElements();bindEvents();renderPalette();renderGrid()}

function cacheElements(){el={login:document.getElementById('login'),main:document.getElementById('main'),loginName:document.getElementById('login-name'),loginBtn:document.getElementById('login-btn'),userBadge:document.getElementById('user-badge'),userAvatar:document.getElementById('user-avatar'),userName:document.getElementById('user-name'),logoutBtn:document.getElementById('logout-btn'),quotaFill:document.getElementById('quota-fill'),quotaText:document.getElementById('quota-text'),canvas:document.getElementById('pixel-canvas'),palette:document.getElementById('color-palette'),curColor:document.getElementById('current-color'),cdFill:document.getElementById('cooldown-fill'),cdTime:document.getElementById('cooldown-time'),pixelInfo:document.getElementById('pixel-info'),pxCount:document.getElementById('pixel-count'),resetTime:document.getElementById('reset-time'),zoomLevel:document.getElementById('zoom-level'),gridToggle:document.getElementById('grid-toggle'),roomSelect:document.getElementById('room-select'),roomName:document.getElementById('room-name'),msgs:document.getElementById('chat-messages'),status:document.getElementById('chat-status'),msgInput:document.getElementById('msg-input'),sendBtn:document.getElementById('send-btn'),soundBtn:document.getElementById('sound-btn'),lbHeader:document.getElementById('lb-header'),lbContent:document.getElementById('lb-content'),toastBox:document.getElementById('toast-container')}}

function bindEvents(){
document.querySelectorAll('.avatar-option').forEach(a=>{a.onclick=()=>{document.querySelectorAll('.avatar-option').forEach(x=>x.classList.remove('sel'));a.classList.add('sel');state.avatar=a.dataset.av}});
el.loginBtn.onclick=handleLogin;el.loginName.onkeypress=e=>{if(e.key==='Enter')handleLogin()};
el.logoutBtn.onclick=handleLogout;
document.querySelectorAll('.server-btn').forEach(b=>{b.onclick=()=>switchServer(parseInt(b.dataset.srv))});
document.querySelectorAll('.tool-btn').forEach(t=>{t.onclick=()=>{document.querySelectorAll('.tool-btn').forEach(x=>x.classList.remove('active'));t.classList.add('active');state.tool=t.dataset.tool}});
document.querySelectorAll('.zoom-btn').forEach(b=>{b.onclick=()=>handleZoom(b.dataset.zm)});
el.gridToggle.onchange=()=>{state.showGrid=el.gridToggle.checked;el.canvas.classList.toggle('no-grid',!state.showGrid)};
el.roomSelect.onchange=handleRoomChange;
el.sendBtn.onclick=handleSend;el.msgInput.onkeypress=e=>{if(e.key==='Enter')handleSend()};
el.soundBtn.onclick=()=>{state.soundOn=!state.soundOn;localStorage.setItem('pc_sound',state.soundOn);el.soundBtn.textContent=state.soundOn?'🔊':'🔇';toast(state.soundOn?'Sound ON':'Sound OFF')};
el.lbHeader.onclick=()=>el.lbContent.classList.toggle('open')}

function toast(m){const t=document.createElement('div');t.className='toast';t.textContent=m;el.toastBox.appendChild(t);setTimeout(()=>t.remove(),2500)}

function handleLogin(){const n=el.loginName.value.trim();if(detectXSS(n)){el.loginName.value='';shake(el.loginName);return}
if(!n||n.length<2||n.length>12||/[^a-zA-Z]/.test(n)){shake(el.loginName);toast('Letters only, 2-12 chars!');return}
state.username=n;localStorage.setItem('pc_user',n);localStorage.setItem('pc_avatar',state.avatar);
fetch(state.apiUrl,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'setProfile',username:n,avatar:state.avatar})}).catch(()=>{});
playSound('join');showApp();startPolling();toast('Welcome, '+n+'!')}

function handleLogout(){stopPolling();state.username='';state.lastTs=0;state.displayed.clear();state.pixels={};state.leaderboard={};localStorage.removeItem('pc_user');el.main.classList.add('hidden');el.login.classList.remove('hidden');el.loginName.value='';el.msgs.innerHTML='<div class="chat-welcome"><span class="welcome-icon">👋</span><span>Welcome!</span></div>';renderGrid()}

function showApp(){el.login.classList.add('hidden');el.main.classList.remove('hidden');el.userName.textContent=state.username;el.userAvatar.textContent=state.avatar==='female'?'👧':'👦';el.userBadge.className='user-badge '+state.avatar;el.curColor.style.background=state.color;el.soundBtn.textContent=state.soundOn?'🔊':'🔇';el.cdTime.textContent='';el.msgInput.focus()}

function switchServer(n){if(n===state.server)return;stopPolling();state.server=n;state.apiUrl=SERVERS[n]||SERVERS[1];state.lastTs=0;state.displayed.clear();state.pixels={};state.leaderboard={};state.failCount=0;
document.querySelectorAll('.server-btn').forEach(b=>b.classList.toggle('active',parseInt(b.dataset.srv)===n));
el.msgs.innerHTML='<div class="chat-system">Switched to Server '+n+'</div>';renderGrid();startPolling();toast('Server '+n)}

function renderPalette(){el.palette.innerHTML=CONFIG.COLORS.map((c,i)=>'<div class="color-swatch'+(i===0?' sel':'')+'" style="background:'+c+'" data-c="'+c+'"></div>').join('');
el.palette.onclick=e=>{if(e.target.classList.contains('color-swatch')){document.querySelectorAll('.color-swatch').forEach(s=>s.classList.remove('sel'));e.target.classList.add('sel');state.color=e.target.dataset.c;el.curColor.style.background=state.color}};
el.curColor.style.background=state.color}

function renderGrid(){el.canvas.innerHTML='';el.canvas.style.gridTemplateColumns='repeat('+CONFIG.GRID+',1fr)';
for(let y=0;y<CONFIG.GRID;y++){for(let x=0;x<CONFIG.GRID;x++){const p=document.createElement('div');p.className='pixel';p.dataset.x=x;p.dataset.y=y;el.canvas.appendChild(p)}}
el.canvas.onclick=handleCanvasClick;
el.canvas.onmousemove=e=>{if(!e.target.classList.contains('pixel'))return;const x=e.target.dataset.x,y=e.target.dataset.y,k=x+'_'+y;const info=state.pixels[k];el.pixelInfo.textContent=info?.user?'['+x+','+y+'] by '+info.user:'['+x+','+y+'] empty'};
el.canvas.onmouseleave=()=>{el.pixelInfo.textContent='Hover to see info'}}

function handleCanvasClick(e){if(!e.target.classList.contains('pixel'))return;const x=parseInt(e.target.dataset.x),y=parseInt(e.target.dataset.y);
if(state.tool==='pick'){pickColor(x,y);return}
if(state.tool==='erase'){if(state.canPlace)placePixel(x,y,'#FFFFFF');return}
if(state.canPlace)placePixel(x,y,state.color)}

function pickColor(x,y){const k=x+'_'+y;if(state.pixels[k]){state.color=state.pixels[k].color;el.curColor.style.background=state.color;document.querySelectorAll('.color-swatch').forEach(s=>s.classList.toggle('sel',s.dataset.c===state.color));toast('Color picked!');playSound('pixel')}}

function placePixel(x,y,color){state.canPlace=false;playSound('pixel');updatePixel(x,y,color,state.username);
fetch(state.apiUrl,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'setPixel',x,y,color,username:state.username})}).catch(()=>{});
startCooldown()}

function updatePixel(x,y,c,u){const i=y*CONFIG.GRID+x;const p=el.canvas.children[i];if(p)p.style.background=c;
const k=x+'_'+y;const oldUser=state.pixels[k]?.user;if(oldUser&&oldUser!==u){state.leaderboard[oldUser]=(state.leaderboard[oldUser]||1)-1;if(state.leaderboard[oldUser]<=0)delete state.leaderboard[oldUser]}
state.pixels[k]={color:c,user:u};if(u){state.leaderboard[u]=(state.leaderboard[u]||0)+1}
updateLeaderboard()}

function startCooldown(){const cd=CONFIG.COOLDOWN;let remaining=cd;el.cdFill.style.transition='none';el.cdFill.style.width='100%';el.cdTime.textContent=(cd/1000).toFixed(0)+'s';
requestAnimationFrame(()=>{el.cdFill.style.transition='width '+cd+'ms linear';el.cdFill.style.width='0%'});
const interval=setInterval(()=>{remaining-=100;if(remaining<=0){clearInterval(interval);el.cdTime.textContent='';state.canPlace=true}else{el.cdTime.textContent=(remaining/1000).toFixed(1)+'s'}},100)}

function handleZoom(d){if(d==='in'&&state.zoom<2)state.zoom+=.25;if(d==='out'&&state.zoom>.5)state.zoom-=.25;el.canvas.style.transform='scale('+state.zoom+')';el.zoomLevel.textContent=Math.round(state.zoom*100)+'%'}

function handleRoomChange(){state.room=el.roomSelect.value;state.lastTs=0;state.displayed.clear();el.roomName.textContent=state.room;el.msgs.innerHTML='<div class="chat-system">Joined #'+state.room+'</div>';fetchMessages()}

async function handleSend(){const m=el.msgInput.value.trim();if(!m)return;if(detectXSS(m)){el.msgInput.value='';return}
el.msgInput.value='';el.msgInput.disabled=true;
try{await fetch(state.apiUrl,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'sendMessage',room:state.room,username:state.username,message:m,avatar:state.avatar})});playSound('message');setTimeout(fetchMessages,500)}catch(e){el.msgInput.value=m;toast('Failed to send')}
el.msgInput.disabled=false;el.msgInput.focus()}

async function fetchMessages(){if(state.fetching)return;state.fetching=true;
try{const r=await fetch(state.apiUrl+'?action=getMessages&room='+state.room+'&since='+state.lastTs,{signal:AbortSignal.timeout(8000)});const d=await r.json();
if(d.success){setStatus(true);state.failCount=0;const nm=d.messages.filter(m=>!state.displayed.has(m.timestamp));
if(nm.length){renderMessages(nm);nm.forEach(m=>state.displayed.add(m.timestamp));state.lastTs=d.messages[d.messages.length-1].timestamp;if(nm.some(m=>m.username!==state.username))playSound('message')}}else{handleConnError()}}catch(e){handleConnError()}
state.fetching=false}

function handleConnError(){state.failCount++;setStatus(false);if(state.failCount>=3&&!state.autoSwitched){state.autoSwitched=true;toast('Server busy, switching...');setTimeout(()=>switchServer(state.server===1?2:1),1000)}}

function renderMessages(ms){const wasAtBottom=el.msgs.scrollHeight-el.msgs.scrollTop-el.msgs.clientHeight<50;
ms.forEach(m=>{const own=m.username===state.username;const d=document.createElement('div');d.className='chat-msg'+(own?' own':'');
const av=document.createElement('div');av.className='msg-avatar '+(m.avatar||'male');av.textContent=m.avatar==='female'?'👧':'👦';
const bd=document.createElement('div');bd.className='msg-body';
const hd=document.createElement('div');hd.className='msg-header';
const nm=document.createElement('span');nm.className='msg-name';nm.textContent=m.username;
const tm=document.createElement('span');tm.className='msg-time';const mins=Math.floor((Date.now()-m.timestamp)/60000);tm.textContent=mins<1?'now':mins+'m';
hd.appendChild(nm);hd.appendChild(tm);
const tx=document.createElement('div');tx.className='msg-text';tx.textContent=m.message;
bd.appendChild(hd);bd.appendChild(tx);d.appendChild(av);d.appendChild(bd);el.msgs.appendChild(d)});
if(wasAtBottom)el.msgs.scrollTop=el.msgs.scrollHeight}

async function fetchPixels(){try{const r=await fetch(state.apiUrl+'?action=getPixels');const d=await r.json();if(d.success){el.pxCount.textContent=d.pixels.length;state.leaderboard={};d.pixels.forEach(p=>{const k=p.x+'_'+p.y;state.pixels[k]={color:p.color,user:p.user};if(p.user){state.leaderboard[p.user]=(state.leaderboard[p.user]||0)+1}
const i=p.y*CONFIG.GRID+p.x;const px=el.canvas.children[i];if(px)px.style.background=p.color});updateLeaderboard()}}catch(e){}}

function updateLeaderboard(){const sorted=Object.entries(state.leaderboard).sort((a,b)=>b[1]-a[1]).slice(0,5);
if(sorted.length===0){el.lbContent.innerHTML='<div class="lb-empty">No pixels yet</div>';return}
el.lbContent.innerHTML=sorted.map(([name,count],i)=>'<div class="lb-item"><span class="lb-name">'+(i===0?'🥇':i===1?'🥈':i===2?'🥉':'  ')+' '+name+'</span><span class="lb-count">'+count+'</span></div>').join('')}

async function fetchConfig(){try{const r=await fetch(state.apiUrl+'?action=getConfig&username='+encodeURIComponent(state.username));const d=await r.json();if(d.success){el.pxCount.textContent=d.totalPixels||0;el.resetTime.textContent=d.hoursUntilReset||12}}catch(e){}}

async function checkStatus(){try{const r=await fetch(state.apiUrl+'?action=getStatus',{signal:AbortSignal.timeout(5000)});const d=await r.json();if(d.success){state.quota=d.quotaUsed||0;el.quotaFill.style.width=state.quota+'%';el.quotaText.textContent=state.quota+'%'}}catch(e){}}

function startPolling(){fetchMessages();fetchPixels();fetchConfig();checkStatus();state.chatTimer=setInterval(fetchMessages,CONFIG.CHAT_POLL);state.pixelTimer=setInterval(fetchPixels,CONFIG.PIXEL_POLL);setInterval(checkStatus,30000)}
function stopPolling(){clearInterval(state.chatTimer);clearInterval(state.pixelTimer)}
function setStatus(ok){state.connected=ok;el.status.className='chat-status '+(ok?'on':'off');el.status.querySelector('.status-text').textContent=ok?'Connected':'Reconnecting...'}
function shake(e){e.classList.add('shake');setTimeout(()=>e.classList.remove('shake'),400)}

return{init}})();

document.addEventListener('DOMContentLoaded',PixelChat.init);
</script>
</body>
</html>
