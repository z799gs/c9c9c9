<?xml version="1.0" encoding="UTF-8" ?>
<Module>
<ModulePrefs title="Pixel Chat" />
<Content type="html"><![CDATA[
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
*{box-sizing:border-box;margin:0;padding:0}
.pc-app{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;max-width:1100px;margin:0 auto;border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.5);background:#0f0f1a}

/* MAVI TEMA */
:root{--bg1:#0f0f1a;--bg2:#1a1a2e;--bg3:#16213e;--text1:#fff;--text2:#8892b0;--accent:#667eea;--accent2:#764ba2;--border:#2d3a5a}

/* LOGIN */
.pc-login{min-height:550px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);padding:20px}
.login-card{background:linear-gradient(145deg,#1e1e30,#252540);padding:40px 35px;border-radius:24px;width:100%;max-width:360px;text-align:center;border:1px solid #3a3a5a;box-shadow:0 25px 50px rgba(0,0,0,.4)}
.login-logo{font-size:56px;margin-bottom:10px;animation:float 3s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.login-card h1{font-size:26px;color:#fff;margin-bottom:5px;background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.login-card>p{color:#8892b0;font-size:14px;margin-bottom:25px}
.avatar-sel{display:flex;gap:20px;justify-content:center;margin-bottom:25px}
.av-opt{font-size:42px;padding:15px 25px;border-radius:16px;border:3px solid #3a3a5a;cursor:pointer;transition:all .3s;background:#1a1a2e}
.av-opt:hover{transform:scale(1.05);border-color:#667eea}
.av-opt.sel{border-color:#667eea;background:linear-gradient(135deg,rgba(102,126,234,.2),rgba(118,75,162,.2));box-shadow:0 0 20px rgba(102,126,234,.3)}
.login-card input{width:100%;padding:14px 18px;border:2px solid #3a3a5a;border-radius:12px;font-size:16px;margin-bottom:15px;background:#16213e;color:#fff;transition:all .3s}
.login-card input:focus{outline:none;border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.2)}
.login-card input::placeholder{color:#5a6a8a}
.login-btn{width:100%;padding:14px;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:600;cursor:pointer;transition:all .3s}
.login-btn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(102,126,234,.4)}
.login-rules{margin-top:20px;font-size:12px;color:#5a6a8a}

/* HEADER */
.pc-header{display:flex;align-items:center;justify-content:space-between;padding:12px 20px;background:linear-gradient(90deg,#1a1a2e,#16213e);border-bottom:1px solid #2d3a5a}
.h-left{display:flex;align-items:center;gap:10px}
.h-logo{font-size:26px}
.h-title{font-weight:700;font-size:18px;color:#fff}
.h-center{display:flex;align-items:center;gap:12px}
.srv-btn{padding:6px 14px;border:none;border-radius:8px;background:#2d3a5a;color:#8892b0;cursor:pointer;font-size:12px;font-weight:600;transition:all .2s}
.srv-btn.active{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff}
.srv-btn:hover:not(.active){background:#3d4a6a}
.quota-box{width:80px;height:24px;background:#2d3a5a;border-radius:12px;overflow:hidden;position:relative}
.quota-fill{height:100%;background:linear-gradient(90deg,#4CAF50,#8BC34A);transition:width .5s;border-radius:12px}
#quota-text{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:10px;font-weight:700;color:#fff}
.h-right{display:flex;align-items:center;gap:10px}
.h-btn{width:36px;height:36px;border:none;border-radius:10px;background:#2d3a5a;cursor:pointer;font-size:18px;transition:all .2s;display:flex;align-items:center;justify-content:center}
.h-btn:hover{background:#3d4a6a;transform:scale(1.05)}
.h-btn.exit{background:#e94560}
.h-btn.exit:hover{background:#ff6b6b}
.user-info{display:flex;align-items:center;gap:8px;background:#2d3a5a;padding:6px 14px;border-radius:20px;font-size:13px;color:#fff}

/* BODY */
.pc-body{display:grid;grid-template-columns:1fr 300px;height:500px;background:#0f0f1a}
@media(max-width:800px){.pc-body{grid-template-columns:1fr;height:auto}.chat-panel{height:350px}}

/* CANVAS PANEL */
.canvas-panel{padding:15px;display:flex;flex-direction:column;gap:12px;overflow:hidden}
.canvas-tools{display:flex;align-items:center;justify-content:space-between;padding:12px 15px;background:#1a1a2e;border-radius:12px;border:1px solid #2d3a5a}
.tool-group{display:flex;align-items:center;gap:8px}
.tool{width:40px;height:40px;border:2px solid transparent;border-radius:10px;background:#2d3a5a;cursor:pointer;font-size:18px;transition:all .2s;display:flex;align-items:center;justify-content:center}
.tool:hover{background:#3d4a6a}
.tool.active{border-color:#667eea;background:linear-gradient(135deg,rgba(102,126,234,.2),rgba(118,75,162,.2))}
.zoom-btn{width:32px;height:32px;border:none;border-radius:8px;background:#2d3a5a;cursor:pointer;font-size:16px;color:#fff;transition:all .2s}
.zoom-btn:hover{background:#3d4a6a}
#zoom-val{font-size:12px;color:#8892b0;min-width:45px;text-align:center}
.grid-chk{display:flex;align-items:center;gap:6px;font-size:12px;color:#8892b0;cursor:pointer}
.grid-chk input{accent-color:#667eea}

/* CANVAS */
.canvas-area{flex:1;display:flex;flex-direction:column;gap:8px;min-height:0}
.canvas-wrap{flex:1;display:flex;align-items:center;justify-content:center;background:#16213e;border-radius:12px;overflow:hidden;border:1px solid #2d3a5a}
.pixel-grid{display:grid;width:320px;height:320px;background:#fff;border:2px solid #667eea;transform-origin:center;transition:transform .3s;box-shadow:0 0 30px rgba(102,126,234,.3)}
.px{background:#fff;border:.5px solid rgba(0,0,0,.03);cursor:crosshair;transition:transform .15s}
.px:hover{transform:scale(1.8);z-index:10;box-shadow:0 0 8px rgba(0,0,0,.3)}
.pixel-grid.no-grid .px{border:none}
.px.pop{animation:pop .25s}
@keyframes pop{0%{transform:scale(1)}50%{transform:scale(2.2)}100%{transform:scale(1)}}
.pixel-info{text-align:center;font-size:11px;color:#8892b0}

/* COLORS */
.color-bar{display:flex;align-items:center;gap:12px;padding:10px 15px;background:#1a1a2e;border-radius:12px;border:1px solid #2d3a5a}
.cur-color{width:42px;height:42px;border-radius:10px;border:3px solid #667eea;box-shadow:0 4px 15px rgba(0,0,0,.3)}
.palette{display:flex;flex-wrap:wrap;gap:4px;flex:1}
.swatch{width:22px;height:22px;border-radius:6px;cursor:pointer;border:2px solid transparent;transition:all .15s}
.swatch:hover{transform:scale(1.2)}
.swatch.sel{border-color:#fff;box-shadow:0 0 10px rgba(255,255,255,.5)}

/* COOLDOWN */
.cooldown-wrap{display:flex;align-items:center;gap:10px}
.cooldown{flex:1;height:6px;background:#2d3a5a;border-radius:3px;overflow:hidden}
.cd-fill{height:100%;background:linear-gradient(90deg,#667eea,#764ba2);transition:width linear;border-radius:3px}
#cd-time{font-size:12px;color:#667eea;font-weight:600;min-width:25px}
.canvas-footer{display:flex;justify-content:space-between;font-size:11px;color:#8892b0;padding:0 5px}

/* LEADERBOARD */
.leaderboard{background:#1a1a2e;border-radius:10px;border:1px solid #2d3a5a;margin-top:8px}
.lb-header{display:flex;justify-content:space-between;align-items:center;padding:8px 12px;cursor:pointer;font-size:12px;color:#8892b0}
.lb-header:hover{background:#252540}
.lb-content{display:none;padding:8px 12px;border-top:1px solid #2d3a5a}
.lb-content.open{display:block}
.lb-item{display:flex;justify-content:space-between;padding:4px 0;font-size:11px}
.lb-name{color:#fff}
.lb-count{color:#667eea;font-weight:600}
.lb-empty{color:#5a6a8a;font-size:11px;text-align:center;padding:8px}

/* CHAT PANEL */
.chat-panel{display:flex;flex-direction:column;background:#1a1a2e;border-left:1px solid #2d3a5a;overflow:hidden}
.chat-head{display:flex;justify-content:space-between;align-items:center;padding:12px 15px;border-bottom:1px solid #2d3a5a}
.chat-head span{font-weight:600;color:#fff;font-size:14px}
#room-sel{padding:5px 10px;border:1px solid #2d3a5a;border-radius:6px;background:#16213e;color:#fff;font-size:11px;cursor:pointer}
.chat-msgs{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:10px;min-height:0}
.chat-welcome{text-align:center;padding:20px;color:#5a6a8a;font-size:13px}
.sys-msg{text-align:center;padding:8px;color:#667eea;font-size:12px;background:#16213e;border-radius:8px}
.msg{display:flex;gap:10px;animation:msgIn .3s}
@keyframes msgIn{from{opacity:0;transform:translateY(8px)}}
.msg.own{flex-direction:row-reverse}
.msg-ava{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.msg-ava.male{background:linear-gradient(135deg,#4a90d9,#667eea)}
.msg-ava.female{background:linear-gradient(135deg,#e91e8c,#ff6b9d)}
.msg-body{background:#16213e;padding:10px 14px;border-radius:16px;max-width:190px;border:1px solid #2d3a5a}
.msg.own .msg-body{background:linear-gradient(135deg,#667eea,#764ba2);border:none}
.msg-head{display:flex;justify-content:space-between;gap:8px;margin-bottom:3px}
.msg-name{font-weight:600;font-size:11px;color:#fff}
.msg-time{font-size:9px;color:#5a6a8a}
.msg.own .msg-time{color:rgba(255,255,255,.6)}
.msg-text{font-size:13px;line-height:1.4;word-break:break-word;color:#ccd6f6}
.msg.own .msg-text{color:#fff}

/* STATUS & INPUT */
.chat-status{display:flex;align-items:center;gap:6px;padding:8px 15px;font-size:10px;color:#5a6a8a;border-top:1px solid #2d3a5a}
.status-dot{width:8px;height:8px;border-radius:50%;background:#e94560}
.chat-status.on .status-dot{background:#4CAF50;box-shadow:0 0 8px #4CAF50}
.chat-input-area{padding:12px;border-top:1px solid #2d3a5a}
.chat-input-row{display:flex;gap:8px;align-items:center}
#msg-input{flex:1;padding:10px 16px;border:2px solid #2d3a5a;border-radius:25px;font-size:13px;background:#16213e;color:#fff;transition:all .3s}
#msg-input:focus{outline:none;border-color:#667eea;box-shadow:0 0 0 3px rgba(102,126,234,.2)}
#msg-input::placeholder{color:#5a6a8a}
.send-btn{width:42px;height:42px;border-radius:50%;border:none;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;cursor:pointer;font-size:18px;transition:all .2s;display:flex;align-items:center;justify-content:center}
.send-btn:hover{transform:scale(1.1);box-shadow:0 5px 20px rgba(102,126,234,.4)}

/* RULES */
.rules-box{padding:8px 12px;font-size:10px;border-top:1px solid #2d3a5a;color:#5a6a8a}
.rules-box summary{cursor:pointer;color:#667eea}
.rules-box div{margin-top:6px;line-height:1.6}

/* TOAST */
.toast-box{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);z-index:2000}
.toast{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;padding:12px 24px;border-radius:25px;font-size:13px;box-shadow:0 10px 30px rgba(0,0,0,.3);opacity:0;transform:translateY(15px);transition:all .3s}
.toast.show{opacity:1;transform:translateY(0)}

.hidden{display:none!important}
.shake{animation:shake .4s}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
</style>
</head>
<body style="margin:0;padding:10px;background:#0a0a12;">
<div id="pixel-chat-container"></div>
<script>
const PixelChatApp=(function(){'use strict';
const SERVERS={1:'SERVER_1_URL',2:'SERVER_2_URL'};
const CONFIG={CHAT_POLL:4000,PIXEL_POLL:3000,GRID_SIZE:64,COOLDOWN:3000,
COLORS:['#000000','#FFFFFF','#FF0000','#00FF00','#0000FF','#FFFF00','#FF00FF','#00FFFF','#FF8000','#8000FF','#0080FF','#FF0080','#808080','#C0C0C0','#800000','#008000','#000080','#808000','#FFC0CB','#FFD700','#A52A2A','#4B0082','#EE82EE','#FA8072','#7FFFD4','#D2691E','#DC143C','#00CED1']};

let state={server:1,apiUrl:SERVERS[1],username:'',avatar:'male',room:'general',color:'#000000',lastTs:0,displayed:new Set(),chatTimer:null,pixelTimer:null,connected:false,fetching:false,canPlace:true,pixels:{},quota:0,zoom:1,tool:'draw',showGrid:true,failCount:0,autoSwitched:false,soundOn:true,leaderboard:{}};
let el={};

// SOUNDS
const sounds={ctx:null};
function initSounds(){try{sounds.ctx=new(window.AudioContext||window.webkitAudioContext)()}catch(e){}}
function playSound(type){if(!state.soundOn||!sounds.ctx)return;try{const o=sounds.ctx.createOscillator();const g=sounds.ctx.createGain();o.connect(g);g.connect(sounds.ctx.destination);const f={message:880,pixel:660,join:1100,error:330};o.frequency.value=f[type]||600;o.type='sine';g.gain.setValueAtTime(.06,sounds.ctx.currentTime);g.gain.exponentialRampToValueAtTime(.01,sounds.ctx.currentTime+.1);o.start();o.stop(sounds.ctx.currentTime+.1)}catch(e){}}

function detectXSS(t){return t&&/<[^>]+>|javascript:|on\w+=/i.test(t)}

function init(id){const c=document.getElementById(id);if(!c)return;
state.username=localStorage.getItem('pc_user')||'';
state.avatar=localStorage.getItem('pc_avatar')||'male';
state.soundOn=localStorage.getItem('pc_sound')!=='false';
state.server=1;state.apiUrl=SERVERS[1];
render(c);initSounds();
if(state.username){showApp();startPolling()}}

function render(c){c.innerHTML=`
<div class="pc-app">
<div id="pc-login" class="pc-login">
<div class="login-card">
<div class="login-logo">🎨</div>
<h1>Pixel Chat</h1>
<p>Draw & Chat Together</p>
<div class="avatar-sel">
<div class="av-opt ${state.avatar==='male'?'sel':''}" data-av="male">👦</div>
<div class="av-opt ${state.avatar==='female'?'sel':''}" data-av="female">👧</div>
</div>
<input type="text" id="login-name" placeholder="Nickname (letters only)" maxlength="12">
<button class="login-btn" id="login-btn">Join Chat →</button>
<div class="login-rules">✓ Letters only ✓ Be respectful ✓ Have fun!</div>
</div>
</div>

<div id="pc-main" class="pc-main hidden">
<header class="pc-header">
<div class="h-left"><span class="h-logo">🎨</span><span class="h-title">Pixel Chat</span></div>
<div class="h-center">
<button class="srv-btn active" data-srv="1">S1</button>
<button class="srv-btn" data-srv="2">S2</button>
<div class="quota-box"><div class="quota-fill" id="quota-fill"></div><span id="quota-text">0%</span></div>
</div>
<div class="h-right">
<button class="h-btn" id="sound-btn">🔊</button>
<div class="user-info"><span id="user-avatar">👦</span><span id="user-name"></span></div>
<button class="h-btn exit" id="logout-btn">✕</button>
</div>
</header>

<div class="pc-body">
<div class="canvas-panel">
<div class="canvas-tools">
<div class="tool-group">
<button class="tool active" data-tool="draw" title="Draw">✏️</button>
<button class="tool" data-tool="erase" title="Eraser">🧹</button>
<button class="tool" data-tool="pick" title="Pick Color">💉</button>
</div>
<div class="tool-group">
<button class="zoom-btn" data-zm="out">−</button>
<span id="zoom-val">100%</span>
<button class="zoom-btn" data-zm="in">+</button>
</div>
<div class="tool-group">
<label class="grid-chk"><input type="checkbox" id="grid-chk" checked> Grid</label>
</div>
</div>

<div class="canvas-area">
<div class="canvas-wrap"><div class="pixel-grid" id="pixel-grid"></div></div>
<div class="pixel-info" id="pixel-info">Hover on pixel for info</div>
</div>

<div class="color-bar">
<div class="cur-color" id="cur-color"></div>
<div class="palette" id="palette"></div>
</div>

<div class="cooldown-wrap">
<div class="cooldown"><div class="cd-fill" id="cd-fill"></div></div>
<span id="cd-time"></span>
</div>

<div class="canvas-footer">
<span>🖼️ <span id="px-count">0</span> pixels</span>
<span>⏰ Resets in <span id="px-reset">12</span>h</span>
</div>

<div class="leaderboard">
<div class="lb-header" id="lb-header">🏆 Top Artists <span>▼</span></div>
<div class="lb-content" id="lb-content"></div>
</div>
</div>

<div class="chat-panel">
<div class="chat-head"><span>#<span id="room-name">general</span></span>
<select id="room-sel"><option value="general">General</option><option value="art">Art</option><option value="random">Random</option></select>
</div>
<div class="chat-msgs" id="chat-msgs"><div class="chat-welcome">👋 Welcome to Pixel Chat!<br>Be nice and have fun.</div></div>
<div class="chat-status" id="chat-status"><span class="status-dot"></span><span class="status-txt">Connecting...</span></div>
<div class="chat-input-area">
<div class="chat-input-row">
<input type="text" id="msg-input" placeholder="Type a message..." maxlength="150">
<button class="send-btn" id="send-btn">➤</button>
</div>
</div>
<details class="rules-box"><summary>📋 Chat Rules</summary><div>• Letters only, no numbers<br>• Be respectful to others<br>• No personal info or links</div></details>
</div>
</div>
</div>
<div class="toast-box" id="toast-box"></div>
</div>`;
cacheElements();bindEvents();renderPalette();renderGrid()}

function cacheElements(){el={login:document.getElementById('pc-login'),main:document.getElementById('pc-main'),loginName:document.getElementById('login-name'),loginBtn:document.getElementById('login-btn'),userAvatar:document.getElementById('user-avatar'),userName:document.getElementById('user-name'),logoutBtn:document.getElementById('logout-btn'),quotaFill:document.getElementById('quota-fill'),quotaText:document.getElementById('quota-text'),grid:document.getElementById('pixel-grid'),palette:document.getElementById('palette'),curColor:document.getElementById('cur-color'),cdFill:document.getElementById('cd-fill'),cdTime:document.getElementById('cd-time'),pixelInfo:document.getElementById('pixel-info'),pxCount:document.getElementById('px-count'),pxReset:document.getElementById('px-reset'),zoomVal:document.getElementById('zoom-val'),gridChk:document.getElementById('grid-chk'),roomSel:document.getElementById('room-sel'),roomName:document.getElementById('room-name'),msgs:document.getElementById('chat-msgs'),status:document.getElementById('chat-status'),msgInput:document.getElementById('msg-input'),sendBtn:document.getElementById('send-btn'),soundBtn:document.getElementById('sound-btn'),lbHeader:document.getElementById('lb-header'),lbContent:document.getElementById('lb-content'),toastBox:document.getElementById('toast-box')}}

function bindEvents(){
document.querySelectorAll('.av-opt').forEach(a=>{a.onclick=()=>{document.querySelectorAll('.av-opt').forEach(x=>x.classList.remove('sel'));a.classList.add('sel');state.avatar=a.dataset.av}});
el.loginBtn.onclick=handleLogin;el.loginName.onkeypress=e=>{if(e.key==='Enter')handleLogin()};
el.logoutBtn.onclick=handleLogout;
document.querySelectorAll('.srv-btn').forEach(b=>{b.onclick=()=>switchServer(parseInt(b.dataset.srv))});
document.querySelectorAll('.tool').forEach(t=>{t.onclick=()=>{document.querySelectorAll('.tool').forEach(x=>x.classList.remove('active'));t.classList.add('active');state.tool=t.dataset.tool}});
document.querySelectorAll('.zoom-btn').forEach(b=>{b.onclick=()=>handleZoom(b.dataset.zm)});
el.gridChk.onchange=()=>{state.showGrid=el.gridChk.checked;el.grid.classList.toggle('no-grid',!state.showGrid)};
el.roomSel.onchange=handleRoomChange;
el.sendBtn.onclick=handleSend;el.msgInput.onkeypress=e=>{if(e.key==='Enter')handleSend()};
el.soundBtn.onclick=()=>{state.soundOn=!state.soundOn;localStorage.setItem('pc_sound',state.soundOn);el.soundBtn.textContent=state.soundOn?'🔊':'🔇';toast(state.soundOn?'Sound ON':'Sound OFF')};
el.lbHeader.onclick=()=>el.lbContent.classList.toggle('open')}

function toast(m){const t=document.createElement('div');t.className='toast';t.textContent=m;el.toastBox.appendChild(t);setTimeout(()=>t.classList.add('show'),10);setTimeout(()=>{t.classList.remove('show');setTimeout(()=>t.remove(),300)},2500)}

function handleLogin(){const n=el.loginName.value.trim();if(detectXSS(n)){el.loginName.value='';shake(el.loginName);return}
if(!n||n.length<2||n.length>12||/[^a-zA-Z]/.test(n)){shake(el.loginName);toast('Letters only, 2-12 chars!');return}
state.username=n;localStorage.setItem('pc_user',n);localStorage.setItem('pc_avatar',state.avatar);
fetch(state.apiUrl,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'setProfile',username:n,avatar:state.avatar})}).catch(()=>{});
playSound('join');showApp();startPolling();toast('Welcome, '+n+'!')}

function handleLogout(){stopPolling();state.username='';state.lastTs=0;state.displayed.clear();state.pixels={};state.leaderboard={};localStorage.removeItem('pc_user');el.main.classList.add('hidden');el.login.classList.remove('hidden');el.loginName.value='';el.msgs.innerHTML='<div class="chat-welcome">👋 Welcome!</div>';renderGrid()}

function showApp(){el.login.classList.add('hidden');el.main.classList.remove('hidden');el.userName.textContent=state.username;el.userAvatar.textContent=state.avatar==='female'?'👧':'👦';el.curColor.style.background=state.color;el.soundBtn.textContent=state.soundOn?'🔊':'🔇';el.cdTime.textContent='';el.msgInput.focus()}

function switchServer(n){if(n===state.server)return;stopPolling();state.server=n;state.apiUrl=SERVERS[n]||SERVERS[1];state.lastTs=0;state.displayed.clear();state.pixels={};state.leaderboard={};state.failCount=0;
document.querySelectorAll('.srv-btn').forEach(b=>b.classList.toggle('active',parseInt(b.dataset.srv)===n));
el.msgs.innerHTML='<div class="sys-msg">Switched to Server '+n+'</div>';renderGrid();startPolling();toast('Server '+n)}

function renderPalette(){el.palette.innerHTML=CONFIG.COLORS.map((c,i)=>'<div class="swatch'+(i===0?' sel':'')+'" style="background:'+c+'" data-c="'+c+'"></div>').join('');
el.palette.onclick=e=>{if(e.target.classList.contains('swatch')){document.querySelectorAll('.swatch').forEach(s=>s.classList.remove('sel'));e.target.classList.add('sel');state.color=e.target.dataset.c;el.curColor.style.background=state.color}};
el.curColor.style.background=state.color}

function renderGrid(){el.grid.innerHTML='';el.grid.style.gridTemplateColumns='repeat('+CONFIG.GRID_SIZE+',1fr)';
for(let y=0;y<CONFIG.GRID_SIZE;y++){for(let x=0;x<CONFIG.GRID_SIZE;x++){const p=document.createElement('div');p.className='px';p.dataset.x=x;p.dataset.y=y;el.grid.appendChild(p)}}
el.grid.onmousedown=handleCanvasClick;
el.grid.onmousemove=e=>{if(!e.target.classList.contains('px'))return;const x=e.target.dataset.x,y=e.target.dataset.y,k=x+'_'+y;const info=state.pixels[k];el.pixelInfo.textContent=info?.user?'['+x+','+y+'] by '+info.user:'['+x+','+y+'] empty'};
el.grid.onmouseleave=()=>{el.pixelInfo.textContent='Hover on pixel for info'}}

function handleCanvasClick(e){if(!e.target.classList.contains('px'))return;const x=parseInt(e.target.dataset.x),y=parseInt(e.target.dataset.y);
if(state.tool==='pick'){pickColor(x,y);return}
if(state.tool==='erase'){if(state.canPlace)placePixel(x,y,'#FFFFFF');return}
if(state.canPlace)placePixel(x,y,state.color)}

function pickColor(x,y){const k=x+'_'+y;if(state.pixels[k]){state.color=state.pixels[k].color;el.curColor.style.background=state.color;document.querySelectorAll('.swatch').forEach(s=>s.classList.toggle('sel',s.dataset.c===state.color));toast('Color picked!');playSound('pixel')}}

function placePixel(x,y,color){state.canPlace=false;playSound('pixel');updatePixel(x,y,color,state.username);
fetch(state.apiUrl,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'setPixel',x,y,color,username:state.username})}).catch(()=>{});
startCooldown()}

function updatePixel(x,y,c,u){const i=y*CONFIG.GRID_SIZE+x;const p=el.grid.children[i];if(p){p.style.background=c;p.classList.add('pop');setTimeout(()=>p.classList.remove('pop'),250)}
const k=x+'_'+y;const oldUser=state.pixels[k]?.user;if(oldUser&&oldUser!==u){state.leaderboard[oldUser]=(state.leaderboard[oldUser]||1)-1;if(state.leaderboard[oldUser]<=0)delete state.leaderboard[oldUser]}
state.pixels[k]={color:c,user:u};if(u){state.leaderboard[u]=(state.leaderboard[u]||0)+1}
updateLeaderboard()}

function startCooldown(){const cd=CONFIG.COOLDOWN;let remaining=cd;el.cdFill.style.transition='none';el.cdFill.style.width='100%';el.cdTime.textContent=(cd/1000).toFixed(0)+'s';
requestAnimationFrame(()=>{el.cdFill.style.transition='width '+cd+'ms linear';el.cdFill.style.width='0%'});
const interval=setInterval(()=>{remaining-=100;if(remaining<=0){clearInterval(interval);el.cdTime.textContent='';state.canPlace=true}else{el.cdTime.textContent=(remaining/1000).toFixed(1)+'s'}},100)}

function handleZoom(d){if(d==='in'&&state.zoom<2)state.zoom+=.25;if(d==='out'&&state.zoom>.5)state.zoom-=.25;el.grid.style.transform='scale('+state.zoom+')';el.zoomVal.textContent=Math.round(state.zoom*100)+'%'}

function handleRoomChange(){state.room=el.roomSel.value;state.lastTs=0;state.displayed.clear();el.roomName.textContent=state.room;el.msgs.innerHTML='<div class="sys-msg">Joined #'+state.room+'</div>';fetchMessages()}

async function handleSend(){const m=el.msgInput.value.trim();if(!m)return;if(detectXSS(m)){el.msgInput.value='';return}
el.msgInput.value='';el.msgInput.disabled=true;
try{await fetch(state.apiUrl,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'sendMessage',room:state.room,username:state.username,message:m,avatar:state.avatar})});playSound('message');setTimeout(fetchMessages,500)}catch(e){el.msgInput.value=m;toast('Failed to send')}
el.msgInput.disabled=false;el.msgInput.focus()}

async function fetchMessages(){if(state.fetching)return;state.fetching=true;
try{const r=await fetch(state.apiUrl+'?action=getMessages&room='+state.room+'&since='+state.lastTs,{signal:AbortSignal.timeout(8000)});const d=await r.json();
if(d.success){setStatus(true);state.failCount=0;const nm=d.messages.filter(m=>!state.displayed.has(m.timestamp));
if(nm.length){renderMessages(nm);nm.forEach(m=>state.displayed.add(m.timestamp));state.lastTs=d.messages[d.messages.length-1].timestamp;if(nm.some(m=>m.username!==state.username))playSound('message')}}else{handleConnError()}}catch(e){handleConnError()}
state.fetching=false}

function handleConnError(){state.failCount++;setStatus(false);if(state.failCount>=3&&!state.autoSwitched){state.autoSwitched=true;toast('Server busy, switching...');setTimeout(()=>switchServer(state.server===1?2:1),1000)}}

function renderMessages(ms){const wasAtBottom=el.msgs.scrollHeight-el.msgs.scrollTop-el.msgs.clientHeight<50;
ms.forEach(m=>{const own=m.username===state.username;const d=document.createElement('div');d.className='msg'+(own?' own':'');
const av=document.createElement('span');av.className='msg-ava '+(m.avatar||'male');av.textContent=m.avatar==='female'?'👧':'👦';
const bd=document.createElement('div');bd.className='msg-body';
const hd=document.createElement('div');hd.className='msg-head';
const nm=document.createElement('span');nm.className='msg-name';nm.textContent=m.username;
const tm=document.createElement('span');tm.className='msg-time';const mins=Math.floor((Date.now()-m.timestamp)/60000);tm.textContent=mins<1?'now':mins+'m';
hd.appendChild(nm);hd.appendChild(tm);
const tx=document.createElement('div');tx.className='msg-text';tx.textContent=m.message;
bd.appendChild(hd);bd.appendChild(tx);d.appendChild(av);d.appendChild(bd);el.msgs.appendChild(d)});
if(wasAtBottom)el.msgs.scrollTop=el.msgs.scrollHeight}

async function fetchPixels(){try{const r=await fetch(state.apiUrl+'?action=getPixels');const d=await r.json();if(d.success){el.pxCount.textContent=d.pixels.length;state.leaderboard={};d.pixels.forEach(p=>{const k=p.x+'_'+p.y;state.pixels[k]={color:p.color,user:p.user};if(p.user){state.leaderboard[p.user]=(state.leaderboard[p.user]||0)+1}
const i=p.y*CONFIG.GRID_SIZE+p.x;const px=el.grid.children[i];if(px)px.style.background=p.color});updateLeaderboard()}}catch(e){}}

function updateLeaderboard(){const sorted=Object.entries(state.leaderboard).sort((a,b)=>b[1]-a[1]).slice(0,5);
if(sorted.length===0){el.lbContent.innerHTML='<div class="lb-empty">No pixels yet</div>';return}
el.lbContent.innerHTML=sorted.map(([name,count],i)=>'<div class="lb-item"><span class="lb-name">'+(i===0?'🥇':i===1?'🥈':i===2?'🥉':'  ')+' '+name+'</span><span class="lb-count">'+count+'</span></div>').join('')}

async function fetchConfig(){try{const r=await fetch(state.apiUrl+'?action=getConfig&username='+encodeURIComponent(state.username));const d=await r.json();if(d.success){el.pxCount.textContent=d.totalPixels||0;el.pxReset.textContent=d.hoursUntilReset||12}}catch(e){}}

async function checkStatus(){try{const r=await fetch(state.apiUrl+'?action=getStatus',{signal:AbortSignal.timeout(5000)});const d=await r.json();if(d.success){state.quota=d.quotaUsed||0;el.quotaFill.style.width=state.quota+'%';el.quotaText.textContent=state.quota+'%'}}catch(e){}}

function startPolling(){fetchMessages();fetchPixels();fetchConfig();checkStatus();state.chatTimer=setInterval(fetchMessages,CONFIG.CHAT_POLL);state.pixelTimer=setInterval(fetchPixels,CONFIG.PIXEL_POLL);setInterval(checkStatus,30000)}
function stopPolling(){clearInterval(state.chatTimer);clearInterval(state.pixelTimer)}
function setStatus(ok){state.connected=ok;el.status.className='chat-status '+(ok?'on':'off');el.status.querySelector('.status-txt').textContent=ok?'Connected':'Reconnecting...'}
function shake(e){e.classList.add('shake');setTimeout(()=>e.classList.remove('shake'),400)}

return{init,setServers:(s1,s2)=>{SERVERS[1]=s1;SERVERS[2]=s2}}})();

PixelChatApp.setServers(
  'https://script.google.com/macros/s/AKfycby_DeW_6VNTNJRjrAyObiHxNlbfO-ixuoCDFz-iSh3z0p7akfrdoJZIBT0-vdcQrs3u/exec',
  'https://script.google.com/macros/s/AKfycbzb8iWUXVDRbVpAzY6bcJwGvNP9SmxbWXwUjR9NAlnyGyiF-TJVTxUowBBih0VaoziH/exec'
);
PixelChatApp.init('pixel-chat-container');
</script>
</body>
</html>
